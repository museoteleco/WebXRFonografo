<style>
  .outer-layer {
    width: 300px;
    max-width: 300px;
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-end;
    padding-top: 8px;
    padding-right: 8px;
  }

  .card {
    width: 280px;
    max-width: 280px;
    align-self: center;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border-radius: 22px;
    background-color: rgba(20, 20, 24, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    padding-top: 18px;
    padding-bottom: 18px;
